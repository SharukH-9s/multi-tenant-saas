# Application settings
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8080
RUST_LOG=info,tenant_saas=debug

# =============================================================================
# DATABASE
# Two roles are used. Never swap them.
#
#   app_runtime   — used by the running application (limited: SELECT/INSERT/UPDATE/DELETE only)
#   db_owner      — used by sqlx-cli for migrations (owns schema, can run DDL)
# =============================================================================

# Application runtime account — used by DATABASE_URL in the application binary
DATABASE_URL=postgres://app_runtime:runtime_password@localhost:5432/tenant_saas
DATABASE_MAX_CONNECTIONS=10
DATABASE_ACQUIRE_TIMEOUT_SECS=5

# Migration account — used ONLY by: sqlx migrate run
# Example: DATABASE_URL=$DATABASE_MIGRATION_URL sqlx migrate run ...
DATABASE_MIGRATION_URL=postgres://db_owner:owner_password@localhost:5432/tenant_saas

# =============================================================================
# REDIS
# =============================================================================
REDIS_URL=redis://localhost:6379

# =============================================================================
# OBJECT STORAGE (MinIO for local dev; S3-compatible in production)
# =============================================================================
# Backend: s3 (default), local, memory
OBJECT_STORAGE_BACKEND=s3
OBJECT_STORAGE_ENDPOINT=http://localhost:9000
OBJECT_STORAGE_BUCKET=tenant-documents
OBJECT_STORAGE_REGION=us-east-1
# Required only when OBJECT_STORAGE_BACKEND=s3
OBJECT_STORAGE_ACCESS_KEY=minioadmin
OBJECT_STORAGE_SECRET_KEY=minioadmin
# Optional: filesystem path used when OBJECT_STORAGE_BACKEND=local (default: ./.local-storage)
# OBJECT_STORAGE_LOCAL_PATH=./.local-storage
# Set to false in production when endpoint is https
OBJECT_STORAGE_ALLOW_HTTP=true
# Multipart upload part size in bytes: min 5 MiB (5242880), max 64 MiB (67108864). Default 8 MiB.
OBJECT_STORAGE_PART_SIZE_BYTES=8388608
# Maximum upload size in bytes. Default 20 MiB; hard cap 100 MiB.
MAX_UPLOAD_BYTES=20971520
# How long (seconds) orphaned objects are retained before the reconciler removes them.
STORAGE_ORPHAN_RETENTION_SECS=86400

# =============================================================================
# AUTH
# =============================================================================
JWT_SECRET=changeme-dev-only-must-be-at-least-32-characters-long
JWT_ISSUER=tenant-saas
JWT_AUDIENCE=tenant-saas-api
JWT_EXPIRY_SECS=900
REFRESH_TOKEN_TTL_SECS=1209600

# Password hashing (Argon2id)
ARGON2_MEMORY_KIB=19456
ARGON2_ITERATIONS=2
ARGON2_PARALLELISM=1
AUTH_MAX_CONCURRENT_HASHES=4

# Rate limiting
# How many trusted proxy hops are in front of this service (0 = use TCP peer address).
AUTH_RATE_LIMIT_TRUSTED_PROXY_HOPS=0
AUTH_RATE_LIMIT_WINDOW_SECS=60
AUTH_RATE_LIMIT_PER_IP=10
AUTH_RATE_LIMIT_PER_EMAIL=5

# =============================================================================
# AI PROVIDERS (Phase 4+)
# =============================================================================
# EMBEDDING_PROVIDER=openai
# EMBEDDING_MODEL=text-embedding-3-small
# EMBEDDING_DIMENSION=1536
# EMBEDDING_API_KEY=sk-...

# LLM_PROVIDER=openai
# LLM_MODEL=gpt-4o-mini
# LLM_API_KEY=sk-...

